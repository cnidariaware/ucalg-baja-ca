{
	"name": "ucalg-baja-ca",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"scripts": {
		"start": "vite dev",
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "npm run build && wrangler pages dev",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"deploy": "npm run build && wrangler pages deploy",
		"test:e2e": "playwright install && playwright test",
		"test:e2e:ui": "playwright test --ui --project=Desktop\\ Chrome",
		"test:e2e:chrome": "playwright test --project='Desktop Chrome'",
		"test:e2e:firefox": "playwright test --project='Desktop Firefox'",
		"test:e2e:mobile-chrome": "playwright test --project='Mobile Chrome 360'",
		"test:e2e:mobile-safari": "playwright test --project='Mobile Safari 360'",
		"test:e2e:mobile": "playwright test --project='Mobile Chrome 360' --project='Mobile Safari 360'",
		"test:e2e:desktop": "playwright test --project='Desktop Chrome' --project='Desktop Firefox'",
		"test:e2e:ci": "playwright test --headed=false --workers=1",
		"playwright:install": "playwright install --with-deps"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.53.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@vitest/browser": "^4.0.18",
		"eslint": "^10.0.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.0",
		"svelte": "^5.53.1",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2",
		"wrangler": "^4.67.0"
	},
	"dependencies": {
		"modern-normalize": "^3.0.1"
	}
}
